{
  "name": "studyai",
  "version": "1.0.45",
  "description": "Asistente de estudio — resúmenes, esquemas, exámenes, flashcards",
  "author": "StudyAI",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"electron .\"",
    "dev:vite": "vite",
    "dev:electron": "electron .",
    "build": "vite build",
    "build:electron": "electron-builder",
    "build:all": "powershell -ExecutionPolicy Bypass -File scripts/build-all.ps1",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-mlkit/document-scanner": "^8.1.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "@dagrejs/dagre": "^3.0.0",
    "@tabler/icons-react": "^3.44.0",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.42.2",
    "html-to-image": "^1.11.13",
    "react-pdf": "^10.4.1"
  },
  "devDependencies": {
    "@sentry/react": "^10.56.0",
    "@supabase/supabase-js": "^2.107.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "axios": "^1.6.0",
    "concurrently": "^8.2.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.0",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "katex": "^0.16.9",
    "mermaid": "^10.6.0",
    "postcss": "^8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.8",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^6.20.0",
    "reactflow": "^11.11.4",
    "recharts": "^2.10.0",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0",
    "zustand": "^4.4.0"
  },
  "build": {
    "appId": "com.studyai.app",
    "productName": "MyStudy AI",
    "copyright": "Copyright © 2026 MyStudy AI",
    "protocols": [
      {
        "name": "MyStudy AI Auth",
        "schemes": [
          "mystudyai"
        ]
      }
    ],
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "!python-service",
      "!scripts",
      "!android/**/*",
      "!node_modules/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/argparse/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/debug/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/ms/**/*",
      "node_modules/sax/**/*",
      "node_modules/semver/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/universalify/**/*"
    ],
    "extraResources": [
      {
        "from": "python-service/dist/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/whisper-models/medium",
        "to": "whisper-models/medium",
        "filter": [
          "config.json",
          "tokenizer.json",
          "vocabulary.txt"
        ]
      },
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg.exe"
        ]
      },
      {
        "from": "resources/tesseract",
        "to": "tesseract",
        "filter": [
          "tesseract.exe",
          "*.dll",
          "tessdata/spa.traineddata",
          "tessdata/eng.traineddata",
          "tessdata/osd.traineddata"
        ]
      },
      {
        "from": "build/models-config.json",
        "to": "models-config.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyStudy AI",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "StudyAIUp",
      "repo": "studyai-releases",
      "releaseType": "release"
    }
  }
}